{
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/Home.aspx", "destination": "/index.html" },
    { "source": "/home.aspx", "destination": "/index.html" },
    { "source": "/sites/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
